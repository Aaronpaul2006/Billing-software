# Copy to .env for local development:   cp .env.example .env
# .env is gitignored. These values are LOCAL-DEV PLACEHOLDERS, not secrets:
# never reuse them in staging or production (use a secrets manager there).

# --- Postgres (docker-compose) -----------------------------------------------
# Bootstrap superuser, used only to create roles and the database.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-dev-postgres
POSTGRES_DB=billing
# 5433, not 5432: a native PostgreSQL service may already use 5432 on this machine.
POSTGRES_PORT=5433

# --- Redis (Celery broker, cache, rate limits) -------------------------------
REDIS_PASSWORD=local-dev-redis
# 6380, not 6379: a native Redis service may already use 6379.
REDIS_PORT=6380

# --- S3-compatible storage (SeaweedFS locally; AWS S3 / R2 in production) ----
# Letters and digits only (the dev container writes them into a JSON config).
S3_ACCESS_KEY=localdevaccesskey
S3_SECRET_KEY=localdevsecretkey0123456789
S3_BUCKET=billing-local
S3_PORT=8333
S3_ENDPOINT_URL=http://localhost:8333

# --- Mail (Mailpit catches everything; UI at http://localhost:8025) ---------
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
