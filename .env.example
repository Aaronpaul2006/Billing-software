# Copy to .env for local development:   cp .env.example .env
# .env is gitignored. These values are LOCAL-DEV PLACEHOLDERS, not secrets:
# never reuse them in staging or production (use a secrets manager there).

# --- Postgres (docker-compose) -----------------------------------------------
# Bootstrap superuser, used only to create roles and the database.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-dev-postgres
POSTGRES_DB=billing
# 5433, not 5432: a native PostgreSQL service may already use 5432 on this machine.
POSTGRES_PORT=5433

# --- Redis (Celery broker, cache, rate limits) -------------------------------
REDIS_PASSWORD=local-dev-redis
# 6380, not 6379: a native Redis service may already use 6379.
REDIS_PORT=6380

# --- S3-compatible storage (SeaweedFS locally; AWS S3 / R2 in production) ----
# Letters and digits only (the dev container writes them into a JSON config).
S3_ACCESS_KEY=localdevaccesskey
S3_SECRET_KEY=localdevsecretkey0123456789
S3_BUCKET=billing-local
S3_PORT=8333
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_REGION=us-east-1

# --- Mail (Mailpit catches everything; UI at http://localhost:8025) ---------
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Billing <no-reply@localhost>
# Links in emails (verify, reset password) open the web app here.
APP_BASE_URL=http://localhost:5173
# true: run Celery tasks (emails, PDFs) inside the API process, no worker needed. Dev only.
CELERY_TASK_ALWAYS_EAGER=false
# Proxies in front of the API that add X-Forwarded-For (1 behind one load balancer).
TRUSTED_PROXY_COUNT=0
# false switches the Redis rate limits off (e.g. load tests). Keep true in production.
RATE_LIMIT_ENABLED=true

# --- Django ------------------------------------------------------------------
# Local only. Production: a random 50+ character value from a secrets manager.
DJANGO_SECRET_KEY=local-dev-insecure-secret-key-do-not-use-anywhere-else
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 ::1 first and stalls.
# The API connects as billing_app_login (member of billing_app: RLS applies).
DATABASE_URL=postgres://billing_app_login:local-dev-app@127.0.0.1:5433/billing
# Migrations run as the table owner:  manage.py migrate --database=owner
DATABASE_OWNER_URL=postgres://billing_owner:local-dev-owner@127.0.0.1:5433/billing
# The same two passwords, for the api / worker containers (docker-compose).
APP_DB_PASSWORD=local-dev-app
OWNER_DB_PASSWORD=local-dev-owner
# Superuser, used only by scripts/bootstrap_db.py to create the roles above.
DATABASE_ADMIN_URL=postgres://postgres:local-dev-postgres@127.0.0.1:5433/postgres
REDIS_URL=redis://:local-dev-redis@127.0.0.1:6380/0

# --- Auth --------------------------------------------------------------------
# Local only. Production: 32+ random bytes each, from a secrets manager / KMS.
JWT_SIGNING_KEY=local-dev-jwt-signing-key-not-a-secret-0123456789
# base64 of 32 bytes ("local-dev-mfa-key-32-bytes-long!")
MFA_ENCRYPTION_KEY=bG9jYWwtZGV2LW1mYS1rZXktMzItYnl0ZXMtbG9uZyE=
