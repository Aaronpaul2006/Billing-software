# Production settings for deploy/docker-compose.prod.yml. Copy to /opt/billing/.env
# on the server (chmod 600) and fill every value. Never commit the real file.
# Generate secrets with:  openssl rand -base64 48   (MFA key: openssl rand -base64 32)

# --- Site -------------------------------------------------------------------------------
DOMAIN=app.example.in                  # DNS A record pointing at the server
APP_URL=https://app.example.in         # links in emails; allowed origin for uploads
ACME_EMAIL=you@example.in              # Let's Encrypt expiry notices

# --- Images (set by the deploy workflow; local builds otherwise) ------------------------
BACKEND_IMAGE=ghcr.io/aaronpaul2006/billing-backend:latest
WEB_IMAGE=ghcr.io/aaronpaul2006/billing-web:latest
RELEASE=latest

# --- Secrets ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=                     # 50+ random characters
JWT_SIGNING_KEY=                       # 43+ random characters
MFA_ENCRYPTION_KEY=                    # exactly 32 random bytes, base64: openssl rand -base64 32

# --- Database and Redis (containers on this server; volumes postgres-data, redis-data) ---
POSTGRES_PASSWORD=                     # superuser: only the migrate job uses it
OWNER_DB_PASSWORD=                     # billing_owner: migrations
APP_DB_PASSWORD=                       # billing_app_login: the API and workers
REDIS_PASSWORD=

# --- Object storage: S3-compatible, in India (AWS S3 ap-south-1, or Cloudflare R2) -------
# A private bucket for the app; keys with access to that bucket only.
S3_ENDPOINT_URL=                       # R2: https://<account-id>.r2.cloudflarestorage.com ; AWS: leave empty
S3_PUBLIC_ENDPOINT_URL=                # usually the same as S3_ENDPOINT_URL (AWS: empty)
S3_REGION=ap-south-1                   # R2: auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Origin the browser uploads to (Content-Security-Policy connect-src):
#   R2: https://<account-id>.r2.cloudflarestorage.com   AWS: https://s3.ap-south-1.amazonaws.com
STORAGE_ORIGIN=

# S3_PROVIDER for the backup container (rclone): AWS, Cloudflare or Other
S3_PROVIDER=AWS

# --- Backups: a SEPARATE bucket (ideally another account / region), its own keys -------
# Public key from `age-keygen` (keep the private key OFF the server: you need it to restore).
BACKUP_AGE_RECIPIENT=                  # age1...
BACKUP_S3_PROVIDER=AWS                 # AWS, Cloudflare or Other
BACKUP_S3_ENDPOINT_URL=                # R2: https://<account-id>.r2.cloudflarestorage.com ; AWS: empty
BACKUP_S3_REGION=ap-south-2            # e.g. Hyderabad, away from the app bucket; R2: auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_HOUR=21                         # UTC: 21:00 UTC = 02:30 IST
BACKUP_KEEP_DAYS=30                    # 0: never delete (use a lifecycle rule and a no-delete key)
BACKUP_PING_URL=                       # optional dead-man switch, e.g. https://hc-ping.com/<uuid>

# --- Email (SMTP of a transactional provider; SPF + DKIM on the sending domain) -------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Billing <no-reply@example.in>

# --- Errors (optional): https://sentry.io project DSN -----------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Size ---------------------------------------------------------------------------------
WEB_CONCURRENCY=3                      # gunicorn workers: about 2 x CPUs - 1 next to the rest
