# Where the app finds the API (no trailing slash, no /api/v1).
# On a phone with Expo Go: your PC's address on the same Wi-Fi, and run the
# API with `manage.py runserver 0.0.0.0:8000` (add the address to
# DJANGO_ALLOWED_HOSTS). Android emulator: http://10.0.2.2:8000.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
